{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Office Suite",
  "version": "0.1.0",
  "identifier": "com.office-suite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Office Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "default"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2024 Office Suite Team",
    "category": "Productivity",
    "shortDescription": "A modern office suite with data reference capabilities",
    "longDescription": "Office Suite is a modern office application that provides seamless integration between Word and Excel with advanced data reference and traceability features.",
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Word Document",
        "role": "Editor"
      },
      {
        "ext": ["xlsx"],
        "name": "Excel Spreadsheet",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": {
      "all": true
    },
    "notification": {
      "all": true
    },
    "clipboard-manager": {
      "all": true
    }
  }
}
